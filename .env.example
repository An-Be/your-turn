# Server-only. Never prefix these with NEXT_PUBLIC_, never commit real values.
# Both use the least-privilege role `yourturn_app` (SELECT/INSERT/UPDATE/DELETE on app tables only).

# Pooled (hostname contains -pooler): used by the app at runtime
DATABASE_URL="postgresql://yourturn_app:PASSWORD@ep-XXXX-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Direct (no -pooler): used only by `npm run db:check` (build-time schema drift check)
DIRECT_URL="postgresql://yourturn_app:PASSWORD@ep-XXXX.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
