// Full schema for M1–M3, so later milestones need no migration churn.

// Prisma 7: the datasource URL lives in prisma.config.ts, not here.
// The client is generated as TypeScript into src/lib/generated/prisma (gitignored).

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Player {
  A
  B
}

enum NightStatus {
  DONE
  SKIPPED
}

enum EventType {
  DONE
  SKIP
  SWAP
  UNDO
  CORRECT
  BACKFILL
  ROTATE
}

model Household {
  id             String   @id @default(cuid())
  token          String   @unique
  playerAName    String
  playerBName    String
  currentStarter Player   @default(A)
  createdAt      DateTime @default(now())
  nights         Night[]
  events         Event[]
}

model Night {
  id          String      @id @default(cuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  date        String      @db.Char(10) // yyyy-mm-dd, client-local
  starter     Player
  status      NightStatus
  appliedFlip Boolean     @default(false) // did this write flip currentStarter? Undo reverses only this.
  recordedBy  Player?
  recordedAt  DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([householdId, date])
}

model Event {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  type        EventType
  date        String?   @db.Char(10)
  by          Player?
  at          DateTime  @default(now())

  @@index([householdId, at])
}

// Fixed-window rate limiter (src/lib/server/rate-limit.ts), shared with tool-template.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([key, windowStart])
  @@index([windowStart])
}
